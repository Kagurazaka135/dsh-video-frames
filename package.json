{
  "name": "dsh-video-frames",
  "version": "0.1.0",
  "description": "Extract video frames for DeepSeek Harness (DSH): uniform sampling, scene-aware shot detection, GIF clips, metadata probe. Merged tool + split tools.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
